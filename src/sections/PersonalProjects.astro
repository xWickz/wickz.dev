---
import { SquareArrowOutUpRight } from "lucide-react";
import GitHub from "@/components/icons/GitHub.astro";
import { personalProjects } from "@/config/personal-projects";
import FeaturedProject from "@/sections/FeaturedProjects.astro";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/Card";
import { Separator } from "@/components/ui/Separator";

import { useTranslations } from "@/i18n/utils";

interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;

const t = useTranslations(lang, "PersonalProjects");
const q = useTranslations(lang, "PersonalProjects_Data");
const compactProjects = personalProjects.slice(2);
---

<section class="flex w-full flex-col gap-6" id="personal-projects">
  <div class="mt-12">
    <div class="relative block">
      <div
        class="absolute inset-0 -z-10 opacity-10 bg-[repeating-linear-gradient(-45deg,#d4d4d8_0px,#d4d4d8_2px,transparent_1px,transparent_10px)]"
        aria-hidden="true"
      >
      </div>

      <h2
        class="pl-1 max-w-2xl text-4xl text-zinc-600 dark:text-zinc-200 font-bold tracking-tighter hover_blink select-none"
      >
        <span class="blink_effect">{t("title")}</span>
      </h2>
    </div>
  </div>

  <Separator />

  <h2
    class="max-w-2xl text-3xl text-zinc-600 dark:text-zinc-200 font-bold tracking-tighter hover_blink select-none"
  >
    <span class="blink_effect">{t("featured")}</span>
  </h2>

  <div class="flex flex-col gap-6" id="personalprojects">
    <FeaturedProject lang={lang} />

    <div class="grid w-full gap-3 sm:grid-cols-1">
      {
        compactProjects.map(({ id, newproject, href, demo, stack }) => (
          <Card className="h-fit w-full">
            <CardHeader>
              <CardTitle className="flex items-center gap-2 w-full justify-center">
                <span class="pr-1 text-sm">{q(`${id}.title`)}</span>
                {newproject && (
                  <span class="bg-amber-500/10 text-amber-700 dark:text-amber-400 font-bold px-1.5 py-0.5 rounded inline-block text-xs">
                    {t("new")}
                  </span>
                )}
                {demo && (
                  <a
                    href={demo}
                    target="_blank"
                    rel="noopener"
                    class="hover_blink"
                  >
                    <SquareArrowOutUpRight className="w-4 h-4 text-zinc-500 blink_effect" />
                  </a>
                )}

                {href && (
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener"
                    class="hover_blink"
                  >
                    <GitHub class="w-4 h-4 text-zinc-500 blink_effect" />
                  </a>
                )}

                <span
                  class="pl-1 text-zinc-600 text-sm hidden sm:block"
                  set:html={q(`${id}.description`)}
                />

                <div class="ml-auto hidden sm:block">
                  {stack.map((item) => (
                    <span class="hover:grayscale-0 grayscale transition-all duration-150 inline-flex items-center p-1">
                      {item.Icon && (
                        <item.Icon className="size-4" aria-hidden="true" />
                      )}
                    </span>
                  ))}
                </div>
              </CardTitle>

              <CardDescription className="sm:hidden block">
                <span set:html={q(`${id}.description`)} />
              </CardDescription>
            </CardHeader>

            <CardContent className="sm:hidden block">
              <div class="ml-auto block sm:hidden">
                {stack.map((item) => (
                  <span class="hover:grayscale-0 grayscale transition-all duration-150 inline-flex items-center p-1">
                    {item.Icon && (
                      <item.Icon className="size-4" aria-hidden="true" />
                    )}
                  </span>
                ))}
              </div>
            </CardContent>
          </Card>
        ))
      }
    </div>
  </div>
</section>
