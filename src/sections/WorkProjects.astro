---
// src/components/Projects.astro
import { Projects as ProjectsList } from "@/config/projects";
import { WorkAccordion } from "@/components/react/WorkAccordion";

import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/Card";
import { Separator } from "@/components/ui/Separator";

// Importamos nuestra utilidad i18n
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;

const t = useTranslations(lang, "Projects");
const q = useTranslations(lang, "Projects_Data");
---

<section class="flex w-full flex-col gap-6" id="projects">
  <div class="mt-3">
    <div class="relative block">
      <div
        class="absolute inset-0 -z-10 opacity-10 bg-[repeating-linear-gradient(-45deg,#d4d4d8_0px,#d4d4d8_2px,transparent_1px,transparent_10px)]"
        aria-hidden="true"
      >
      </div>

      <h2
        class="pl-1 max-w-2xl text-4xl text-zinc-600 dark:text-zinc-200 font-bold tracking-tighter hover_blink select-none"
      >
        <span class="blink_effect">{t("title")}</span>
      </h2>
    </div>
  </div>

  <Separator />

  <div class="grid w-full gap-8 sm:grid-cols-2">
    {
      ProjectsList.map((project) => {
        const translations = {
          time: q(`${project.id}.time`),
          problem: q(`${project.id}.problem`),
          solution: q(`${project.id}.solution`),
          results: q(`${project.id}.results`),
          CTAProblem: t("CTAProblem"),
          CTASolution: t("CTASolution"),
          CTAResults: t("CTAResults"),
        };

        return (
          <Card className="max-w-lg">
            <CardHeader>
              <CardTitle>{project.title}</CardTitle>
              <CardDescription>
                <p class="font-semibold text-xs">{translations.time}</p>
              </CardDescription>
            </CardHeader>
            <CardContent>
              <WorkAccordion
                client:visible
                project={project}
                translations={translations}
              />
            </CardContent>
          </Card>
        );
      })
    }
  </div>
</section>
