---
import { socialMedia } from "@/config/social-media";
import ThemeToggle from "@/components/ui/theme-toggle.astro";
import LanguageToggle from "@/components/ui/language-toggle.astro";
import CvDownload from "@/components/ui/cv-download.astro";
import { useTranslations } from "@/i18n/utils";
import { NAV_LINKS } from "@/lib/constants";

interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;
const t = useTranslations(lang, "links");
---

<header
  class="relative z-40 w-full max-w-[100rem] px-4 py-5 dark:border-zinc-700 sm:px-5"
>
  <div class="flex items-center justify-between">
    <a
      href={`/${lang}/`}
      class="font-bold hover:underline hover:underline-offset-4 transition-all duration-500"
    >
      wickz.dev
    </a>

    <div class="hidden items-center gap-4 text-sm font-semibold sm:flex">
      {
        Object.entries(NAV_LINKS).map(([name, href]) => (
          <a
            href={href}
            class="hover:underline hover:dark:text-zinc-100 hover:text-zinc-500 hover_blink"
          >
            <p class="blink_effect">{t(name)}</p>
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <CvDownload lang={lang} />
      <LanguageToggle lang={lang} />
      <ThemeToggle />
      <div class="hidden items-center gap-2 sm:flex">
        {
          socialMedia.map(({ label, href, Icon }) => (
            <a
              href={href}
              aria-label={label}
              target="_blank"
              rel="noopener noreferrer"
              class="hover_blink"
            >
              <Icon class="size-5 fill-zinc-600 transition-colors duration-150 dark:fill-zinc-400 dark:hover:fill-zinc-300 blink_effect" />
            </a>
          ))
        }
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="sm:hidden rounded-md border border-zinc-200 px-3 py-1 text-xs font-semibold text-zinc-700 dark:border-zinc-700 dark:text-zinc-200 active:scale-95 transition-transform"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        Menu
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    class="hidden mt-3 flex-col gap-4 rounded-md border border-zinc-200 bg-white/95 p-4 text-sm font-semibold text-zinc-700 shadow-sm dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-200"
  >
    <nav class="flex flex-col gap-3">
      {
        Object.entries(NAV_LINKS).map(([name, href]) => (
          <a
            href={href}
            class="mobile-link hover:underline hover:dark:text-zinc-100 hover:text-zinc-500 hover_blink"
          >
            <span class="blink_effect">{t(name)}</span>
          </a>
        ))
      }
    </nav>
    <div
      class="flex items-center gap-3 pt-2 border-t border-zinc-200 dark:border-zinc-800"
    >
      {
        socialMedia.map(({ label, href, Icon }) => (
          <a
            href={href}
            aria-label={label}
            target="_blank"
            rel="noopener noreferrer"
            class="hover_blink"
          >
            <Icon class="size-5 fill-zinc-600 transition-colors duration-150 dark:fill-zinc-400 dark:hover:fill-zinc-300 blink_effect" />
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("menu-toggle");
  const mobileNav = document.getElementById("mobile-nav");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  toggleBtn?.addEventListener("click", () => {
    const isHidden = mobileNav?.classList.contains("hidden");

    if (isHidden) {
      mobileNav?.classList.remove("hidden");
      mobileNav?.classList.add("flex");
      toggleBtn.setAttribute("aria-expanded", "true");
    } else {
      mobileNav?.classList.add("hidden");
      mobileNav?.classList.remove("flex");
      toggleBtn.setAttribute("aria-expanded", "false");
    }
  });

  // Cerrar menú al hacer clic en un enlace
  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      mobileNav?.classList.add("hidden");
      mobileNav?.classList.remove("flex");
      toggleBtn?.setAttribute("aria-expanded", "false");
    });
  });
</script>
