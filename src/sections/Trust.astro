---
import { Clock, MapPin, TrendingUp } from "lucide-react";
import { Separator } from "@/components/ui/Separator";
import { process } from "@/config/home";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;
const t = useTranslations(lang, "Trust");
const steps = process[lang === "en" ? "en" : "es"];

const signals = [
  { Icon: MapPin, title: t("locationTitle"), text: t("location") },
  { Icon: Clock, title: t("responseTitle"), text: t("response") },
  { Icon: TrendingUp, title: t("resultsTitle"), text: t("results") },
];
---

<section class="flex w-full flex-col gap-6" id="process">
  <div class="mt-12">
    <div class="relative block">
      <div
        class="absolute inset-0 -z-10 opacity-10 bg-[repeating-linear-gradient(-45deg,#d4d4d8_0px,#d4d4d8_2px,transparent_1px,transparent_10px)]"
        aria-hidden="true"
      >
      </div>
      <h2
        class="pl-1 max-w-2xl text-4xl text-zinc-600 dark:text-zinc-200 font-bold tracking-tighter hover_blink select-none"
      >
        <span class="blink_effect">{t("title")}</span>
      </h2>
    </div>
  </div>

  <Separator />

  <ul class="grid gap-4 sm:grid-cols-3">
    {
      signals.map(({ Icon, title, text }) => (
        <li class="flex gap-3 items-start text-left">
          <div class="flex size-9 items-center justify-center rounded-lg border border-zinc-200 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900 shrink-0">
            <Icon className="size-4.5 text-zinc-700 dark:text-zinc-300" aria-hidden="true" />
          </div>
          <div>
            <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">{title}</h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400" set:html={text} />
          </div>
        </li>
      ))
    }
  </ul>

  <h3 class="mt-4 text-2xl font-bold tracking-tighter text-zinc-600 dark:text-zinc-200">
    {t("processTitle")}
  </h3>
  <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      steps.map((step, i) => (
        <li class="rounded-lg border border-zinc-200 dark:border-zinc-800 p-4 text-left">
          <span class="text-xs font-semibold text-blue-500/90">0{i + 1}</span>
          <p class="mt-1 font-semibold text-zinc-900 dark:text-zinc-100">{step.title}</p>
          <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{step.text}</p>
        </li>
      ))
    }
  </ol>
</section>
