---
import { ArrowRight } from "lucide-react";
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
} from "@/components/ui/Card";
import { Separator } from "@/components/ui/Separator";
import { serviceGroups, services } from "@/config/services";
import { mailto } from "@/lib/constants";
import { useTranslations } from "@/i18n/utils";
import { findPage, getPages, pagePath } from "@/lib/routes";

interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;

const t = useTranslations(lang, "Services");
const q = useTranslations(lang, "Services_Data");
const p = useTranslations(lang, "Page");
const pages = await getPages();
---

<section class="flex w-full flex-col gap-6" id="services">
  <div class="mt-12">
    <div class="relative block">
      <div
        class="absolute inset-0 -z-10 opacity-10 bg-[repeating-linear-gradient(-45deg,#d4d4d8_0px,#d4d4d8_2px,transparent_1px,transparent_10px)]"
        aria-hidden="true"
      >
      </div>

      <h2
        class="pl-1 max-w-2xl text-4xl text-zinc-600 dark:text-zinc-200 font-bold tracking-tighter hover_blink select-none"
      >
        <span class="blink_effect">{t("title")}</span>
      </h2>
    </div>

    <p
      class="mt-2 text-zinc-600 dark:text-zinc-400 text-sm sm:text-base max-w-2xl font-normal tracking-tight"
    >
      {t("subtitle")}
    </p>
  </div>

  <Separator />

  {
    serviceGroups.map((group) => (
      <div class="flex flex-col gap-3">
        <h3 class="pl-1 text-xl font-bold tracking-tight text-zinc-700 dark:text-zinc-300">
          {t(`group.${group}`)}
        </h3>
        <div class="grid w-full gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {services
            .filter((s) => s.group === group)
            .map(({ id, Icon }) => {
              const title = q(`${id}.title`);
              const page = findPage(pages, id, lang);
              const quoteHref = mailto(
                `${t("quoteSubject")}: ${title} [home]`,
                t("quoteBody").replace("{service}", title),
              );

              return (
                <Card className="h-full hover_blink">
                  <CardHeader>
                    <div class="flex items-center gap-3">
                      <div class="flex size-9 items-center justify-center rounded-lg border border-zinc-200 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900 shrink-0">
                        <Icon className="size-4.5 text-zinc-700 dark:text-zinc-300 blink_effect" />
                      </div>
                      <CardTitle className="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
                        {title}
                      </CardTitle>
                    </div>
                    <CardDescription className="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed mt-2">
                      {q(`${id}.description`)}
                    </CardDescription>
                  </CardHeader>

                  <CardContent className="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2">
                    {page && (
                      <a
                        href={pagePath(page)}
                        class="group/cta inline-flex w-fit items-center gap-1 text-sm font-medium text-blue-500/90 hover:underline underline-offset-4"
                      >
                        {p("seeService")}
                        <span class="sr-only">: {title}</span>
                        <ArrowRight
                          className="size-3.5 transition-transform group-hover/cta:translate-x-0.5"
                          aria-hidden="true"
                        />
                      </a>
                    )}
                    <a
                      href={quoteHref}
                      class={
                        page
                          ? "text-sm text-zinc-600 dark:text-zinc-400 hover:underline underline-offset-4"
                          : "text-sm font-medium text-blue-500/90 hover:underline underline-offset-4"
                      }
                    >
                      {t("CTAQuote")}
                    </a>
                  </CardContent>
                </Card>
              );
            })}
        </div>
      </div>
    ))
  }
</section>
