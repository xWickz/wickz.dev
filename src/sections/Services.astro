---
import { ArrowRight, ArrowUpRight } from "lucide-react";
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
} from "@/components/ui/Card";
import { Separator } from "@/components/ui/Separator";
import { services } from "@/config/services";
import { SITE } from "@/lib/constants";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;

const t = useTranslations(lang, "Services");
const q = useTranslations(lang, "Services_Data");
---

<section class="flex w-full flex-col gap-6" id="services">
  <div class="mt-12">
    <div class="relative block">
      <div
        class="absolute inset-0 -z-10 opacity-10 bg-[repeating-linear-gradient(-45deg,#d4d4d8_0px,#d4d4d8_2px,transparent_1px,transparent_10px)]"
        aria-hidden="true"
      >
      </div>

      <h2
        class="pl-1 max-w-2xl text-4xl text-zinc-600 dark:text-zinc-200 font-bold tracking-tighter hover_blink select-none"
      >
        <span class="blink_effect">{t("title")}</span>
      </h2>
    </div>

    <p
      class="mt-2 text-zinc-600 dark:text-zinc-400 text-sm sm:text-base max-w-2xl font-normal tracking-tight"
    >
      {t("subtitle")}
    </p>
  </div>

  <Separator />

  <div class="grid w-full gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      services.map(({ id, Icon, demos = [] }) => {
        const title = q(`${id}.title`);
        const quoteHref = `mailto:${SITE.email}?subject=${encodeURIComponent(`${t("quoteSubject")}: ${title}`)}&body=${encodeURIComponent(t("quoteBody").replace("{service}", title))}`;

        return (
          <Card className="h-full hover_blink">
            <CardHeader>
              <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-lg border border-zinc-200 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900 shrink-0">
                  <Icon className="size-4.5 text-zinc-700 dark:text-zinc-300 blink_effect" />
                </div>
                <CardTitle className="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
                  {title}
                </CardTitle>
              </div>
              <CardDescription className="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed mt-2">
                {q(`${id}.description`)}
              </CardDescription>
            </CardHeader>

            <CardContent className="mt-auto flex flex-col gap-3">
              {demos.length > 0 && (
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-xs font-semibold text-zinc-500 mr-1">
                    {demos.length > 1 ? t("demos") : t("demo")}
                  </span>
                  {demos.map((demo) => (
                    <a
                      href={demo.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-0.5 rounded-md border border-zinc-200 dark:border-zinc-800 px-2 py-0.5 text-xs text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors"
                    >
                      {demo.label}
                      <ArrowUpRight className="size-3" aria-hidden="true" />
                    </a>
                  ))}
                </div>
              )}

              <a
                href={quoteHref}
                class="group/quote inline-flex w-fit items-center gap-1 text-sm font-medium text-blue-500/90 hover:underline underline-offset-4"
              >
                {t("CTAQuote")}
                <ArrowRight
                  className="size-3.5 transition-transform group-hover/quote:translate-x-0.5"
                  aria-hidden="true"
                />
              </a>
            </CardContent>
          </Card>
        );
      })
    }
  </div>
</section>
