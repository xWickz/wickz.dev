    <script>
      (() => {
        let stored = "";
        try {
          stored = localStorage.getItem("preferred-lang") ?? "";
        } catch {}

        const browser = navigator.language?.split("-")[0] ?? "";
        const lang = ["es", "en"].includes(stored)
          ? stored
          : ["es", "en"].includes(browser)
            ? browser
            : "es";

        setTimeout(() => window.location.replace(`/${lang}/`), 600);
      })();
