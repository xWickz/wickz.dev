---
import Layout from "@/layouts/BaseLayout.astro";
import Hero from "@/sections/Hero.astro";
import Services from "@/sections/Services.astro";
import PersonalProjects from "@/sections/PersonalProjects.astro";
import WorkProjects from "@/sections/WorkProjects.astro";
import ContactMe from "@/sections/ContactMe.astro";
import { useTranslations } from "@/i18n/utils";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang, "SEO");
---

<Layout
  title={t("title")}
  description={t("description")}
  lang={lang}
  canonicalURL={`/${lang}/`}
>
  <div
    class="flex w-full max-w-[100rem] flex-col gap-6 text-center sm:text-left mx-auto z-10"
  >
    <Hero lang={lang} />
    <Services lang={lang} />
    <WorkProjects lang={lang} />
    <PersonalProjects lang={lang} />
    <ContactMe lang={lang} />
  </div>
</Layout>
