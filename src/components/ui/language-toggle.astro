---
interface Props {
  lang?: string;
}
const { lang = "es" } = Astro.props;
---

<button
  id="lang-toggle"
  type="button"
  class="rounded-md border border-zinc-200 px-2 py-1 text-xs font-semibold text-zinc-700 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-200 dark:hover:bg-zinc-800 active:scale-95 transition-all"
  aria-label="Toggle language"
>
  <span id="lang-label">{lang.toUpperCase()}</span>
</button>

<script>
  const LANG_KEY = "preferred-lang";
  const SUPPORTED = ["es", "en"];
  const DEFAULT = "es";

  function getCurrentLang(): string {
    const path = window.location.pathname;
    if (path.startsWith("/en")) return "en";
    return "es";
  }

  function switchLang(current: string): string {
    return current === "es" ? "en" : "es";
  }

  function getTargetUrl(newLang: string): string {
    const path = window.location.pathname;
    const hash = window.location.hash;

    if (newLang === "en") {
      const rest = path.replace(/^\/es/, "") || "/";
      return `/en${rest}${hash}`;
    } else {
      const rest = path.replace(/^\/en/, "") || "/";
      return `/es${rest}${hash}`;
    }
  }

  function updateLabel(lang: string) {
    const label = document.getElementById("lang-label");
    if (label) label.textContent = lang.toUpperCase();
  }

  const btn = document.getElementById("lang-toggle");
  btn?.addEventListener("click", () => {
    const current = getCurrentLang();
    const next = switchLang(current);
    localStorage.setItem(LANG_KEY, next);
    updateLabel(next);
    window.location.href = getTargetUrl(next);
  });

  updateLabel(getCurrentLang());
</script>
