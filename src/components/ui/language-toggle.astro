---
interface Props {
  lang?: string;
  /** Misma página en el otro idioma (o su home si no existe traducción). */
  href?: string;
}
const { lang = "es", href = lang === "en" ? "/es/" : "/en/" } = Astro.props;
const target = lang === "en" ? "es" : "en";
---

<a
  id="lang-toggle"
  href={href}
  hreflang={target}
  class="rounded-md border border-zinc-200 px-2 py-1 text-xs font-semibold text-zinc-700 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-200 dark:hover:bg-zinc-800 active:scale-95 transition-all"
  aria-label={lang === "en" ? "Ver en español" : "View in English"}
>
  {lang.toUpperCase()}
</a>

<script>
  // Conserva la sección actual (#services, etc.) al cambiar de idioma
  document.getElementById("lang-toggle")?.addEventListener("click", (e) => {
    const link = e.currentTarget as HTMLAnchorElement;
    if (location.hash) link.href = link.href.split("#")[0] + location.hash;
  });
</script>
