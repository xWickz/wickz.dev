{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.wickz.dev" }],
      "destination": "https://wickz.dev/:path*",
      "statusCode": 301
    },
    {
      "source": "/",
      "destination": "/es/",
      "statusCode": 301
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "statusCode": 301
    }
  ]
}
